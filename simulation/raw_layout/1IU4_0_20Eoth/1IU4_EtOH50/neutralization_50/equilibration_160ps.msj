task { task = "desmond:auto" }

simulate {
 title = "GUI-style relaxation stage 1"
 time = 100
 timestep = [0.001 0.001 0.003]
 temperature = 10.0
 pressure = [1.01325 isotropic]
 ensemble = { class = NVT method = Brownie
               thermostat.tau = 0.1 barostat.tau = 2.0 }
 restrain = { atom = "(atom.num 1-5208) and not atom.ele H" force_constant = 50 }
 eneseq.interval = 1.0
 checkpt.write_last_step = true
 compress = ""
 ensemble.brownie.delta_max = 0.1
 
}

simulate {
 title = "GUI-style relaxation stage 2"
 time = 12
 timestep = [0.001 0.001 0.003]
 temperature = 10.0
 pressure = [1.01325 isotropic]
 ensemble = { class = NVT method = Langevin
               thermostat.tau = 0.1 barostat.tau = 2.0 }
 restrain = { atom = "(atom.num 1-5208) and not atom.ele H" force_constant = 50 }
 eneseq.interval = 1.0
 checkpt.write_last_step = true
 compress = ""
 
 
}

simulate {
 title = "GUI-style relaxation stage 3"
 time = 12
 timestep = [0.001 0.001 0.003]
 temperature = 10.0
 pressure = [1.01325 isotropic]
 ensemble = { class = NPT method = Langevin
               thermostat.tau = 0.1 barostat.tau = 2.0 }
 restrain = { atom = "(atom.num 1-5208) and not atom.ele H" force_constant = 50 }
 eneseq.interval = 1.0
 checkpt.write_last_step = true
 compress = ""
 
 
}

simulate {
 title = "GUI-style relaxation stage 4"
 time = 12
 timestep = [0.001 0.001 0.003]
 temperature = 298.0
 pressure = [1.01325 isotropic]
 ensemble = { class = NPT method = Langevin
               thermostat.tau = 0.1 barostat.tau = 2.0 }
 restrain = { atom = "(atom.num 1-5208) and not atom.ele H" force_constant = 50 }
 eneseq.interval = 1.0
 checkpt.write_last_step = true
 compress = ""
 
 
}

simulate {
 title = "GUI-style relaxation stage 5"
 time = 24
 timestep = [0.002 0.002 0.006]
 temperature = 298.0
 pressure = [1.01325 isotropic]
 ensemble = { class = NPT method = MTK
               thermostat.tau = 0.1 barostat.tau = 2.0 }
 restrain = none
 eneseq.interval = 1.0
 checkpt.write_last_step = true
 compress = ""
 
 jobname = "$MAINJOBNAME"
dir = "."
trajectory = { name = "equil_trj" interval = 1.0 }
maeff_output.trjdir = "equil_trj"
}
