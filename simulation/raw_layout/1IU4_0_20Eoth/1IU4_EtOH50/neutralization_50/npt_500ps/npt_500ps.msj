task { task = "desmond:auto" }
simulate {
 title = "Additional 500 ps NPT equilibration"
 time = 500.0
 timestep = [0.002 0.002 0.006]
 temperature = 298.0
 pressure = [1.01325 isotropic]
 ensemble = { class = NPT method = MTK
              thermostat.tau = 1.0 barostat.tau = 2.0 }
 restrain = none
 trajectory = { name = "npt_trj" interval = 10.0 }
 maeff_output.trjdir = "npt_trj"
 eneseq.interval = 5.0
 checkpt.write_last_step = true
 jobname = "$MAINJOBNAME"
 dir = "."
 compress = ""
}
