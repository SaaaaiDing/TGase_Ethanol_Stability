task { task = "desmond:auto" }



simulate {
 title = "Equilibration stage 1"
 time = 100
 timestep = [0.001 0.001 0.003]
 temperature = 10.0
 pressure = [1.01325 isotropic]
 ensemble = { class = NVT method = Brownie
               thermostat.tau = 0.1 barostat.tau = 2.0 }
 restrain = { atom = "(atom.num 1-5208) and not atom.ele H" force_constant = 50 }
 eneseq.interval = 1.0
 checkpt.write_last_step = true
 compress = ""
 ensemble.brownie.delta_max = 0.1

}

simulate {
 title = "Equilibration stage 2"
 time = 100
 timestep = [0.001 0.001 0.003]
 temperature = 10.0
 pressure = [1.01325 isotropic]
 ensemble = { class = NVT method = Langevin
               thermostat.tau = 0.1 barostat.tau = 2.0 }
 restrain = { atom = "(atom.num 1-5208) and not atom.ele H" force_constant = 50 }
 eneseq.interval = 1.0
 checkpt.write_last_step = true
 compress = ""
 
}

simulate {
 title = "Equilibration stage 3"
 time = 100
 timestep = [0.001 0.001 0.003]
 temperature = 298.0
 pressure = [1.01325 isotropic]
 ensemble = { class = NVT method = Langevin
               thermostat.tau = 0.1 barostat.tau = 2.0 }
 restrain = { atom = "(atom.num 1-5208) and not atom.ele H" force_constant = 50 }
 eneseq.interval = 1.0
 checkpt.write_last_step = true
 compress = ""
 
}

simulate {
 title = "Equilibration stage 4"
 time = 1000
 timestep = [0.001 0.001 0.003]
 temperature = 298.0
 pressure = [1.01325 isotropic]
 ensemble = { class = NPT method = Langevin
               thermostat.tau = 0.1 barostat.tau = 2.0 }
 restrain = { atom = "(atom.num 1-5208) and not atom.ele H" force_constant = 5 }
 eneseq.interval = 1.0
 checkpt.write_last_step = true
 compress = ""
 
}

simulate {
 title = "Equilibration stage 5"
 time = 1000
 timestep = [0.001 0.001 0.003]
 temperature = 298.0
 pressure = [1.01325 isotropic]
 ensemble = { class = NPT method = Langevin
               thermostat.tau = 0.1 barostat.tau = 2.0 }
 restrain = { atom = "(atom.num 1-5208) and not atom.ele H" force_constant = 1 }
 eneseq.interval = 1.0
 checkpt.write_last_step = true
 compress = ""
 
}

simulate {
 title = "Equilibration stage 6"
 time = 5000
 timestep = [0.002 0.002 0.006]
 temperature = 298.0
 pressure = [1.01325 isotropic]
 ensemble = { class = NPT method = MTK
               thermostat.tau = 1.0 barostat.tau = 2.0 }
 restrain = none
 eneseq.interval = 1.0
 checkpt.write_last_step = true
 compress = ""
 jobname = "$MAINJOBNAME"
dir = "."
trajectory = { name = "equil_trj" interval = 10.0 }
maeff_output.trjdir = "equil_trj"

}
